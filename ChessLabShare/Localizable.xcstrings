    "Ouvrez ChessLab : la position s'y lira.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ChessLab: the position will be read there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ChessLab : la position s'y lira."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ChessLab: allí se leerá la posición."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ChessLab: Dort wird die Stellung gelesen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri ChessLab: la posizione verrà letta lì."
          }
        }
      }
    },
    "Partagez une image depuis Photos, puis réessayez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share an image from Photos, then try again."
