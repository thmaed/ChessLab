<?xml version="1.0" encoding="utf-8"?>
<!--
  DÉBOGAGE SEULEMENT (19/11/2026) : l'écran de mesure « coups à la voix ». Ce manifeste ne fusionne que dans la
  version de développement (com.maeder.chesslab.debug) ; la version du Play Store ne reçoit pas cet écran. Le micro et
  la visibilité du service de reconnaissance sont désormais dans le manifeste PRINCIPAL (la fonction « Coups à la
  voix »). Toujours aucune permission INTERNET : la reconnaissance mesurée est celle qui travaille SUR L'APPAREIL.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.chesslab.voicelab.VoiceDictationLabActivity"
            android:label="Mesure dictée"
            android:exported="true"
            android:theme="@style/Theme.ChessLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.chesslab.voicelab.MicLevelActivity"
            android:label="Niveau micro"
            android:exported="true"
            android:theme="@style/Theme.ChessLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
