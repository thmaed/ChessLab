<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export d'une archive vers App Store Connect, téléversement direct
	     par xcodebuild. Signature MANUELLE : le certificat « Apple
	     Distribution » et le profil « ChessLab App Store 2026 » ont été créés
	     par l'API (tools/asc/), parce que la clé d'API n'a pas accès aux
	     certificats gérés dans le nuage par Xcode. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<!-- « … Push » depuis le 16/11/2026 : la capacité Push Notifications (notifications
		     SILENCIEUSES de CloudKit, sans lesquelles un changement fait ailleurs n'arrive qu'au
		     lancement à froid) a été ajoutée à l'identifiant, ce qui invalide l'ancien profil. -->
		<key>com.chesslab.ChessLab</key>
		<string>ChessLab App Store 2026 Push</string>
		<!-- L'extension de partage (07/11/2026) : son propre profil, et le groupe
		     d'app group.com.chesslab.ChessLab porté par les DEUX. -->
		<key>com.chesslab.ChessLab.Share</key>
		<string>ChessLab Share App Store 2026</string>
	</dict>
	<key>teamID</key>
	<string>3N3BN259H6</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
