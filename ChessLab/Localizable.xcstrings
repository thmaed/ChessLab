    "Fermez ChessLab puis rouvrez-le pour que vos parties et votre progression suivent vos appareils.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez ChessLab puis rouvrez-le pour que vos parties et votre progression suivent vos appareils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit ChessLab and reopen it so your games and progress follow you across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra ChessLab y vuelve a abrirlo para que tus partidas y tu progreso te sigan en tus dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende ChessLab und öffne es erneut, damit deine Partien und dein Fortschritt dir auf deine Geräte folgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi ChessLab e riaprilo perché le tue partite e i tuoi progressi ti seguano sui tuoi dispositivi."
          }
        }
      }
    },
