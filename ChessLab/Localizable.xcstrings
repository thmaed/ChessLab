    "Aucune étiquette. Ajoutez-en pour retrouver et regrouper vos parties (ex. « ouverture », « à revoir »).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tags yet. Add some to find and group your games (e.g. “opening”, “to review”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay etiquetas. Añade algunas para encontrar y agrupar tus partidas (p. ej. «apertura», «para repasar»)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Tags. Füge welche hinzu, um deine Partien zu finden und zu gruppieren (z. B. „Eröffnung“, „Wiederholen“)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tag. Aggiungine per ritrovare e raggruppare le tue partite (es. «apertura», «da rivedere»)."
          }
        }
      }
    },
