    "Système London, roque au coup 6, zéro faiblesse. Il maîtrise très bien la théorie et n'a pas perdu depuis des mois. Il dort bien.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "London System, castles on move 6, zero weaknesses. He knows his theory inside out and hasn't lost in months. He sleeps well."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système London, roque au coup 6, zéro faiblesse. Il maîtrise très bien la théorie et n'a pas perdu depuis des mois. Il dort bien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema Londres, enroque en la jugada 6, cero debilidades. Domina la teoría y lleva meses sin perder. Duerme bien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "London-System, Rochade in Zug 6, null Schwächen. Beherrscht die Theorie bestens und hat seit Monaten nicht verloren. Er schläft gut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema London, arrocco alla mossa 6, zero debolezze. Conosce benissimo la teoria e non perde da mesi. Dorme bene."
          }
        }
      }
    },
