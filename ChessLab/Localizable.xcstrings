    "Le modèle Maia-3 tel quel, sans aucune adaptation : joue comme un humain de ce niveau, sans style particulier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Maia-3 model as is, with no adaptation at all: plays like a human of this level, with no particular style."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Maia-3 tel quel, sans aucune adaptation : joue comme un humain de ce niveau, sans style particulier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo Maia-3 tal cual, sin ninguna adaptación: juega como un humano de este nivel, sin un estilo particular."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Maia-3-Modell unverändert, ganz ohne Anpassung: Es spielt wie ein Mensch dieser Stärke, ohne besonderen Stil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello Maia-3 così com'è, senza alcun adattamento: gioca come un umano di questo livello, senza uno stile particolare."
          }
        }
      }
    },
    "Le moteur pioche dans un livre d'ouvertures": {
      "localizations": {
