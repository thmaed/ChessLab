    "Vous avez trouvé proprement chaque puzzle qui correspond à ces filtres lors de votre dernière tentative.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You solved every puzzle matching these filters cleanly on your last attempt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez trouvé proprement chaque puzzle qui correspond à ces filtres lors de votre dernière tentative."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolviste limpiamente todos los puzles que coinciden con estos filtros en tu último intento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast beim letzten Versuch jedes Puzzle gelöst, das zu diesen Filtern passt, und zwar sauber."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai trovato in modo pulito ogni puzzle che corrisponde a questi filtri nel tuo ultimo tentativo."
          }
        }
      }
    },
    "À revoir : il reviendra dans 2 jours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To review: it will come back in 2 days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À revoir : il reviendra dans 2 jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para repasar: volverá dentro de 2 días."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wiederholen: Es kommt in 2 Tagen wieder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da rivedere: tornerà tra 2 giorni."
          }
        }
      }
    },
    "Analyser = revoir vos coups, essayer d'autres lignes et créer des puzzles avec vos erreurs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse = review your moves, try other lines and create puzzles from your mistakes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizar = revisar tus jugadas, probar otras líneas y crear puzles con tus errores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysieren = deine Züge durchgehen, andere Varianten ausprobieren und aus deinen Fehlern Puzzles machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizzare = rivedere le tue mosse, provare altre linee e creare puzzle con i tuoi errori."
          }
        }
      }
    },
    "Analyser ici": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizar aquí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier analysieren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza qui"
          }
        }
      }
    },
    "Ouvre l'analyse sur la position affichée pour essayer d'autres coups": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the analysis on the displayed position so you can try other moves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el análisis en la posición mostrada para probar otras jugadas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Analyse an der angezeigten Stellung, damit du andere Züge ausprobieren kannst"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre l'analisi sulla posizione mostrata per provare altre mosse"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
