    "Vos réglages et la partie en cours se synchronisent déjà. Le reste démarrera à la réouverture.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages et la partie en cours se synchronisent déjà. Le reste démarrera à la réouverture."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings and the game in progress already sync. The rest will start when you reopen the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ajustes y la partida en curso ya se sincronizan. El resto empezará al volver a abrir la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen und die laufende Partie werden bereits synchronisiert. Der Rest startet beim erneuten Öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni e la partita in corso si sincronizzano già. Il resto partirà alla riapertura."
          }
        }
      }
    },
    "Dans Réglages Système, cliquez en haut à gauche pour vous connecter avec votre compte Apple. La synchronisation reprendra d'elle-même.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système, cliquez en haut à gauche pour vous connecter avec votre compte Apple. La synchronisation reprendra d'elle-même."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, click at the top left to sign in with your Apple Account. Syncing will resume on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema, haz clic arriba a la izquierda para iniciar sesión con tu cuenta de Apple. La sincronización se reanudará sola."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in den Systemeinstellungen oben links, um dich mit deinem Apple Account anzumelden. Die Synchronisierung läuft dann von selbst weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni di Sistema, fai clic in alto a sinistra per accedere con il tuo Account Apple. La sincronizzazione riprenderà da sola."
          }
        }
      }
    },
    "Dans les Réglages de l'appareil, touchez la ligne tout en haut et connectez-vous avec votre compte Apple. La synchronisation reprendra d'elle-même.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les Réglages de l'appareil, touchez la ligne tout en haut et connectez-vous avec votre compte Apple. La synchronisation reprendra d'elle-même."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the device's Settings, tap the row at the very top and sign in with your Apple Account. Syncing will resume on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los Ajustes del dispositivo, toca la fila de arriba del todo e inicia sesión con tu cuenta de Apple. La sincronización se reanudará sola."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in den Einstellungen des Geräts ganz oben auf die erste Zeile und melde dich mit deinem Apple Account an. Die Synchronisierung läuft dann von selbst weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle Impostazioni del dispositivo, tocca la riga in alto e accedi con il tuo Account Apple. La sincronizzazione riprenderà da sola."
          }
        }
      }
    },
    "iCloud ne répond pas pour le moment. La synchronisation reprendra d'elle-même.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ne répond pas pour le moment. La synchronisation reprendra d'elle-même."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud isn't responding right now. Syncing will resume on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no responde por ahora. La sincronización se reanudará sola."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud antwortet gerade nicht. Die Synchronisierung läuft dann von selbst weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non risponde al momento. La sincronizzazione riprenderà da sola."
          }
