          }
        }
      }
    },
    "Jeu de pièces vectorielles par Colin M. L. Burnett, le même que Wikipédia et Lichess. Attribution requise, partage dans les mêmes conditions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector piece set by Colin M. L. Burnett, the same one used by Wikipedia and Lichess. Attribution required, share-alike."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeu de pièces vectorielles par Colin M. L. Burnett, le même que Wikipédia et Lichess. Attribution requise, partage dans les mêmes conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juego de piezas vectoriales de Colin M. L. Burnett, el mismo que usan Wikipedia y Lichess. Se requiere atribución y compartir bajo las mismas condiciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektor-Figurensatz von Colin M. L. Burnett, derselbe wie bei Wikipedia und Lichess. Namensnennung erforderlich, Weitergabe unter gleichen Bedingungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Set di pezzi vettoriale di Colin M. L. Burnett, lo stesso di Wikipedia e Lichess. Attribuzione richiesta, condivisione alle stesse condizioni."
          }
        }
      }
    },
