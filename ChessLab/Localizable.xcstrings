    "Commencer une nouvelle partie l'effacera sur tous vos appareils (%lld coup(s) joué(s)).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Partie zu beginnen löscht sie auf allen deinen Geräten (%lld Zug/Züge gespielt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting a new game will erase it on all your devices (%lld move(s) played)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar una nueva partida la borrará en todos tus dispositivos (%lld jugada(s) realizada(s))."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer une nouvelle partie l'effacera sur tous vos appareils (%lld coup(s) joué(s))."
          }
        },
        "it": {
