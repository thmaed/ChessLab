    "Ouvrez le sélecteur d'apps : balayez vers le haut depuis le bas de l'écran et marquez une pause (ou appuyez deux fois sur le bouton principal).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le sélecteur d'apps : balayez vers le haut depuis le bas de l'écran et marquez une pause (ou appuyez deux fois sur le bouton principal)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app switcher: swipe up from the bottom of the screen and pause (or double-press the Home button)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el selector de apps: desliza hacia arriba desde la parte inferior de la pantalla y haz una pausa (o pulsa dos veces el botón de inicio)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den App-Umschalter: Streiche vom unteren Bildschirmrand nach oben und halte kurz inne (oder drücke zweimal die Home-Taste)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il selettore delle app: scorri verso l'alto dal fondo dello schermo e fai una pausa (o premi due volte il tasto Home)."
          }
        }
      }
    },
    "Faites glisser ChessLab vers le haut pour le fermer.": {
      "localizations": {
