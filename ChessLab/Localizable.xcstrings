    "Les réglages et la partie en cours ne sont plus partagés. Pour arrêter aussi le reste, fermez complètement ChessLab puis rouvrez-le.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages et la partie en cours ne sont plus partagés. Pour arrêter aussi le reste, fermez complètement ChessLab puis rouvrez-le."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings and the game in progress are no longer shared. To stop everything else too, quit ChessLab completely and reopen it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes y la partida en curso ya no se comparten. Para detener también el resto, cierra ChessLab por completo y vuelve a abrirlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen und die laufende Partie werden nicht mehr geteilt. Um auch den Rest zu beenden, beende ChessLab vollständig und öffne es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni e la partita in corso non vengono più condivise. Per fermare anche il resto, chiudi completamente ChessLab e riaprilo."
          }
        }
      }
    },
    "Réglages et partie en cours à jour. Le reste attend que vous fermiez et rouvriez ChessLab.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages et partie en cours à jour. Le reste attend que vous fermiez et rouvriez ChessLab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings and game in progress are up to date. The rest waits until you quit and reopen ChessLab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes y partida en curso al día. El resto espera a que cierres y vuelvas a abrir ChessLab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen und laufende Partie sind aktuell. Der Rest wartet, bis du ChessLab beendest und neu öffnest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni e partita in corso aggiornate. Il resto attende che tu chiuda e riapra ChessLab."
          }
        }
      }
    },
