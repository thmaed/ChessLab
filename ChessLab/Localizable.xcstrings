    "Gardée ici quand une autre partie est arrivée d'un autre appareil. Touchez pour la reprendre.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier aufbewahrt, als eine andere Partie von einem anderen Gerät kam. Tippe, um sie fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept here when another game arrived from another device. Tap to resume it."
          }
        },
