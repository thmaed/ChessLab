    "Il faut exactement un roi blanc et un roi noir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There must be exactly one white king and one black king."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut exactement un roi blanc et un roi noir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debe haber exactamente un rey blanco y un rey negro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es muss genau einen weißen und einen schwarzen König geben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve esattamente un re bianco e un re nero."
          }
        }
      }
    },
    "Il manque un roi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A king is missing."
          }
        },
        "fr": {
