    "Offre un pion au deuxième coup, un deuxième au troisième, et cherche le mat avant d'avoir développé sa dame. Ses finales ressemblent à des accidents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers a pawn on move two, another on move three, and hunts for mate before his queen is developed. His endgames look like accidents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre un pion au deuxième coup, un deuxième au troisième, et cherche le mat avant d'avoir développé sa dame. Ses finales ressemblent à des accidents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrece un peón en la segunda jugada, otro en la tercera, y busca el mate antes de haber desarrollado su dama. Sus finales parecen accidentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet im zweiten Zug einen Bauern an, im dritten einen weiteren und sucht das Matt, bevor er seine Dame entwickelt hat. Seine Endspiele wirken wie Unfälle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre un pedone alla seconda mossa, un altro alla terza, e cerca il matto prima di aver sviluppato la donna. I suoi finali sembrano incidenti."
          }
        }
      }
    },
