    "Le scanner lit mieux les captures, les photos d'écran et les plateaux réels. Depuis Photos, « Partager › ChessLab » envoie l'image directement au scanner.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanner reads screenshots, photos of a screen and real boards better. From Photos, “Share › ChessLab” sends the image straight to the scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner lit mieux les captures, les photos d'écran et les plateaux réels. Depuis Photos, « Partager › ChessLab » envoie l'image directement au scanner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner lee mejor las capturas de pantalla, las fotos de pantalla y los tableros reales. Desde Fotos, «Compartir › ChessLab» envía la imagen directamente al escáner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner liest Screenshots, Bildschirmfotos und echte Bretter besser. Aus Fotos sendet „Teilen › ChessLab“ das Bild direkt an den Scanner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner legge meglio screenshot, foto di schermo e scacchiere reali. Da Foto, «Condividi › ChessLab» invia l'immagine direttamente allo scanner."
          }
        }
      }
    },
