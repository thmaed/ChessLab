    "Un appareil manque ? Vérifiez sur lui : même compte Apple, ChessLab à jour, synchronisation activée.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil manque ? Vérifiez sur lui : même compte Apple, ChessLab à jour, synchronisation activée."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device missing? Check on it: same Apple Account, ChessLab up to date, sync turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Falta un dispositivo? Comprueba en él: misma cuenta de Apple, ChessLab actualizado y sincronización activada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt ein Gerät? Prüfe dort: derselbe Apple Account, ChessLab aktuell, Synchronisierung aktiviert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca un dispositivo? Controlla su di esso: stesso Account Apple, ChessLab aggiornato, sincronizzazione attiva."
          }
        }
      }
    },
    "Aucun autre appareil relié pour l'instant. Sur l'autre appareil : même compte Apple, ChessLab à jour, synchronisation activée.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre appareil relié pour l'instant. Sur l'autre appareil : même compte Apple, ChessLab à jour, synchronisation activée."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other device connected yet. On the other device: same Apple Account, ChessLab up to date, sync turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay otro dispositivo conectado. En el otro dispositivo: misma cuenta de Apple, ChessLab actualizado y sincronización activada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein anderes Gerät verbunden. Auf dem anderen Gerät: derselbe Apple Account, ChessLab aktuell, Synchronisierung aktiviert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro dispositivo collegato per ora. Sull'altro dispositivo: stesso Account Apple, ChessLab aggiornato, sincronizzazione attiva."
