            "value": "Juega una jugada en el tablero para añadirla a tu repertorio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele einen Zug auf dem Brett, um ihn deinem Repertoire hinzuzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca una mossa sulla scacchiera per aggiungerla al tuo repertorio."
          }
        }
      }
    },
