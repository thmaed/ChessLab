    "Jeu de données public lichess-org/chess-openings (domaine public). Sert à nommer chaque position atteinte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public dataset lichess-org/chess-openings (public domain). Used to name every position reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conjunto de datos público lichess-org/chess-openings (dominio público). Sirve para nombrar cada posición alcanzada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlicher Datensatz lichess-org/chess-openings (gemeinfrei). Dient dazu, jede erreichte Stellung zu benennen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Set di dati pubblico lichess-org/chess-openings (pubblico dominio). Serve a dare un nome a ogni posizione raggiunta."
          }
        }
      }
    },
