    "Activez iCloud ici aussi pour retrouver vos parties et votre progression.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez iCloud ici aussi pour retrouver vos parties et votre progression."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on iCloud here too to find your games and progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa iCloud también aquí para encontrar tus partidas y tu progreso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere iCloud auch hier, um deine Partien und deinen Fortschritt wiederzufinden."
          }
