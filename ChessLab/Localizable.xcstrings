    "Roque du côté opposé et pions lancés : votre roi est une adresse de livraison. Simplifie mal, même avec deux pions d'avance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Castles on the opposite wing and throws her pawns: your king is a delivery address. Simplifies badly, even two pawns up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roque du côté opposé et pions lancés : votre roi est une adresse de livraison. Simplifie mal, même avec deux pions d'avance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enroca al lado opuesto y lanza los peones: tu rey es una dirección de entrega. Simplifica mal, incluso con dos peones de ventaja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rochiert auf die Gegenseite und stürmt mit den Bauern: Dein König ist eine Lieferadresse. Vereinfacht schlecht, selbst mit zwei Bauern Vorsprung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrocca sul lato opposto e lancia i pedoni: il tuo re è un indirizzo di consegna. Semplifica male, anche con due pedoni di vantaggio."
          }
        }
      }
    },
