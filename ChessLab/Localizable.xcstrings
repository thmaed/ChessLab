    "Vos dernières parties vivent aussi ici : un tap ouvre directement leur analyse, sans passer par la bibliothèque.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest games also live here: one tap opens their analysis directly, without going through the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus últimas partidas también viven aquí: un toque abre directamente su análisis, sin pasar por la biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch deine letzten Partien findest du hier: Ein Tipp öffnet direkt ihre Analyse, ohne Umweg über die Bibliothek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le tue ultime partite vivono qui: un tocco apre direttamente la loro analisi, senza passare dalla libreria."
          }
        }
      }
    },
    "Vos données ne s'enregistrent plus": {
      "localizations": {
