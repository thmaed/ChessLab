    "… et %lld autres parties écartées.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… and %lld more games skipped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "… et %lld autres parties écartées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "… y %lld partidas más descartadas."
          }
        },
        "de": {
          "stringUnit": {
