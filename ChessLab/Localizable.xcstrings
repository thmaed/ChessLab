    "Plateau détecté. Ajustez les coins si besoin : les lignes de la grille doivent suivre les rangées du plateau.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board detected. Adjust the corners if needed: the grid lines must follow the board's ranks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateau détecté. Ajustez les coins si besoin : les lignes de la grille doivent suivre les rangées du plateau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero detectado. Ajusta las esquinas si hace falta: las líneas de la cuadrícula deben seguir las filas del tablero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett erkannt. Passe die Ecken bei Bedarf an: Die Gitterlinien müssen den Reihen des Bretts folgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scacchiera rilevata. Regola gli angoli se serve: le linee della griglia devono seguire le traverse della scacchiera."
          }
        }
      }
    },
    "Plateau non détecté automatiquement. Placez les quatre coins : les lignes de la grille doivent suivre les rangées du plateau.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board not detected automatically. Place the four corners: the grid lines must follow the board's ranks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateau non détecté automatiquement. Placez les quatre coins : les lignes de la grille doivent suivre les rangées du plateau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero no detectado automáticamente. Coloca las cuatro esquinas: las líneas de la cuadrícula deben seguir las filas del tablero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett nicht automatisch erkannt. Setze die vier Ecken: Die Gitterlinien müssen den Reihen des Bretts folgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scacchiera non rilevata automaticamente. Posiziona i quattro angoli: le linee della griglia devono seguire le traverse della scacchiera."
          }
        }
      }
    },
