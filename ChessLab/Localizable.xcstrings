    "Laisse venir, encaisse, sourit. Plus vous attaquez, plus elle est dangereuse ; sa meilleure position est légèrement inférieure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you come, absorbs, smiles. The harder you attack, the more dangerous she gets; her favourite position is slightly worse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse venir, encaisse, sourit. Plus vous attaquez, plus elle est dangereuse ; sa meilleure position est légèrement inférieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja venir, encaja, sonríe. Cuanto más atacas, más peligrosa es; su posición favorita es ligeramente inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt dich kommen, steckt ein, lächelt. Je mehr du angreifst, desto gefährlicher wird sie; ihre liebste Stellung ist leicht schlechter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia venire, incassa, sorride. Più attacchi, più è pericolosa; la sua posizione preferita è leggermente inferiore."
          }
        }
      }
    },
