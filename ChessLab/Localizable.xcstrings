    "Camp proche du maximum et moins de 0,5 s par coup : le temps court bride surtout le camp fort — l'écart réel sera plus petit que l'écart affiché.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One side near maximum with under 0.5 s per move: short time mostly holds back the strong side — the real gap will be smaller than the displayed one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camp proche du maximum et moins de 0,5 s par coup : le temps court bride surtout le camp fort — l'écart réel sera plus petit que l'écart affiché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bando cerca del máximo y menos de 0,5 s por jugada: el poco tiempo limita sobre todo al bando fuerte, así que la diferencia real será menor que la mostrada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite nahe dem Maximum und weniger als 0,5 s pro Zug: Die kurze Zeit bremst vor allem die starke Seite – der tatsächliche Abstand wird kleiner sein als der angezeigte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lato vicino al massimo e meno di 0,5 s per mossa: il tempo breve limita soprattutto il lato forte — il divario reale sarà più piccolo di quello mostrato."
          }
        }
      }
    },
