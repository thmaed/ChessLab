    "L'arbitre et la défense reposent sur le moteur — relancez-le pour continuer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the arbiter and the defence rely on the engine — restart it to continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbitre et la défense reposent sur le moteur — relancez-le pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árbitro y la defensa dependen del motor: reinícialo para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiedsrichter und Verteidigung hängen von der Engine ab – starte sie neu, um fortzufahren."
