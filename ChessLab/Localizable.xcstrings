    "Jeu de pièces vectorielles moderne par Alexis Luengas, issu de la collection open source de Lichess. Compatible avec la licence GPLv3 de l'app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern vector piece set by Alexis Luengas, from Lichess's open-source collection. Compatible with the app's GPLv3 licence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juego de piezas vectoriales moderno de Alexis Luengas, de la colección de código abierto de Lichess. Compatible con la licencia GPLv3 de la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderner Vektor-Figurensatz von Alexis Luengas aus der Open-Source-Sammlung von Lichess. Kompatibel mit der GPLv3-Lizenz der App."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Set di pezzi vettoriale moderno di Alexis Luengas, tratto dalla raccolta open source di Lichess. Compatibile con la licenza GPLv3 dell'app."
          }
        }
      }
    },
    "Jeu de pièces vectorielles par Armando Hernandez Marroquin, issu de la collection open source de Lichess. Compatible avec la licence GPLv3 de l'app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector piece set by Armando Hernandez Marroquin, from Lichess's open-source collection. Compatible with the app's GPLv3 licence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
