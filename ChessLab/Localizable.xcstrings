  "sourceLanguage": "fr",
  "strings": {
    "Lecture pivotée de %lld°. Si le plateau apparaît à l'envers, inversez la lecture.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading rotated by %lld°. If the board looks upside down, flip the reading."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture pivotée de %lld°. Si le plateau apparaît à l'envers, inversez la lecture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura girada %lld°. Si el tablero aparece al revés, invierte la lectura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennung um %lld° gedreht. Steht das Brett auf dem Kopf, kehre die Erkennung um."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura ruotata di %lld°. Se la scacchiera appare capovolta, inverti la lettura."
          }
        }
      }
    },
