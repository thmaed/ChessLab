    "Joue avec Maia-3, un réseau entraîné sur des millions de parties humaines. Stockfish n'intervient que pour les mats courts, les finales à peu de pièces et les répétitions.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays with Maia-3, a network trained on millions of human games. Stockfish only steps in for short mates, endgames with few pieces, and repetitions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue avec Maia-3, un réseau entraîné sur des millions de parties humaines. Stockfish n'intervient que pour les mats courts, les finales à peu de pièces et les répétitions."
          }
        }
      }
    },
    "Joue un autre coup sur l'échiquier pour ajouter une variante.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play another move on the board to add a variation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega otra jugada en el tablero para añadir una variante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele einen weiteren Zug auf dem Brett, um eine Variante hinzuzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca un'altra mossa sulla scacchiera per aggiungere una variante."
          }
        }
      }
    },
    "Joue un coup sur l'échiquier pour l'ajouter à ton répertoire.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a move on the board to add it to your repertoire."
