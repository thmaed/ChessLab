          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La jugada era %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zug war %@"
          }
        },
        "it": {
