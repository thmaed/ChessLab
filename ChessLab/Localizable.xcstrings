    "Stockfish seul : pas de livre d'ouvertures ni de Maia. Les deux parties d'une paire partent de la même position, couleurs inversées.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish only: no opening book and no Maia. The two games of a pair start from the same position, with colours reversed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish seul : pas de livre d'ouvertures ni de Maia. Les deux parties d'une paire partent de la même position, couleurs inversées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Stockfish: sin libro de aperturas ni Maia. Las dos partidas de una pareja parten de la misma posición, con los colores invertidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Stockfish: kein Eröffnungsbuch und kein Maia. Die beiden Partien eines Paares beginnen in derselben Stellung, mit vertauschten Farben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Stockfish: niente libro di aperture né Maia. Le due partite di una coppia partono dalla stessa posizione, a colori invertiti."
          }
        }
      }
    },
