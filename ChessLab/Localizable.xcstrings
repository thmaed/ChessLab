        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbitro e la difesa si basano sul motore — riavvialo per continuare."
          }
        }
      }
    },
    "L'index de toutes les lignes, les coups des maîtres avec leurs pourcentages, et les trois meilleurs coups de Stockfish — calculés d'avance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The index of every line, the masters' moves with their percentages, and Stockfish's three best moves — all computed in advance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'index de toutes les lignes, les coups des maîtres avec leurs pourcentages, et les trois meilleurs coups de Stockfish — calculés d'avance."
          }
        }
      }
    },
    "L'indice et l'alerte gaffe arriveront dans une prochaine version du mode.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hints and the blunder alert will arrive in a future version of this mode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indice et l'alerte gaffe arriveront dans une prochaine version du mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista y el aviso de error grave llegarán en una próxima versión del modo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis und Patzer-Warnung folgen in einer künftigen Version dieses Modus."
          }
