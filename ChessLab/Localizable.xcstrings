    "Plus l'intervalle est court, plus les tours doubles reviennent souvent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shorter the interval, the more often double turns come around."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus l'intervalle est court, plus les tours doubles reviennent souvent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más corto es el intervalo, más a menudo vuelven los turnos dobles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kürzer das Intervall, desto öfter kommen Doppelzüge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più l'intervallo è breve, più spesso tornano i doppi turni."
          }
