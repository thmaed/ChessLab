    "Toutes les cases douteuses ont été vérifiées — relisez le plateau une dernière fois.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All doubtful squares have been checked — read the board over one last time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cases douteuses ont été vérifiées — relisez le plateau une dernière fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han revisado todas las casillas dudosas: vuelve a leer el tablero una última vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle unsicheren Felder wurden geprüft – sieh dir das Brett noch ein letztes Mal an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le case dubbie sono state verificate — rileggi la scacchiera un'ultima volta."
