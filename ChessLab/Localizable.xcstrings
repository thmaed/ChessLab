            "state": "translated",
            "value": "El motor prefiere continuar la partida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine möchte die Partie lieber fortsetzen."
          }
        },
        "it": {
          "stringUnit": {
