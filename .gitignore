# Xcode
build/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods (unlikely here, kept in case)
Pods/

# macOS
.DS_Store

# Entraînement YOLO (scripts/yolo) : outillage local, jamais livré.
# Le modèle EMBARQUÉ est ChessLab/ChessPiecesYOLO.mlpackage, lui versionné.
scripts/yolo/.venv/
scripts/yolo/*.pt
scripts/yolo/runs/
scripts/yolo/ChessPiecesYOLO.mlpackage/
datasets/
runs/
scripts/yolo/__pycache__/

# Jeux de pièces (dont chess.com PROPRIÉTAIRES) : entraînement local, jamais livré ni redistribué.
scripts/yolo/piece-sets/

# Build du package moteur vendorisé
Vendor/CStockfish/.build/

# Binaire Stockfish construit à la main pour `audit.py` et `suggest.py` :
# objets, dépendances, réseaux NNUE et exécutable. Le point d'entrée `main.cpp`
# est lui aussi généré (copie de `_main.cpp` plus un `main` de pont) — voir le
# README du générateur. Rien de tout cela ne doit entrer dans le dépôt : c'est
# reconstructible, et l'exécutable pèse 80 Mo.
Vendor/CStockfish/Sources/CStockfish/stockfish/*.o
Vendor/CStockfish/Sources/CStockfish/stockfish/.depend
Vendor/CStockfish/Sources/CStockfish/stockfish/main.cpp
tools/opening-generator/bin/

# Clés App Store Connect : jamais dans le dépôt, même déposées par erreur
# dans le projet. La clé vit dans ~/.private_keys/ (hors dépôt).
*.p8
.private_keys/
AuthKey_*

# Environnement Python de l'outil App Store Connect
tools/asc/.venv/
__pycache__/

# Spike Maia-3 : outillage local, entièrement reconstructible depuis le README
# du dossier. Rien de tout cela n'entre dans le dépôt — le checkpoint amont
# pèse 88 Mo, l'ONNX fp32 87 Mo et le fp16 43 Mo, et l'environnement Python
# embarque PyTorch. Le fichier VERSIONNÉ, lui, est android_fixture.json
# (145 Ko) : il permet de rejouer la comparaison sans refaire la conversion.
tools/maia3-spike/mlenv/
tools/maia3-spike/maia3/
tools/maia3-spike/*.pt
tools/maia3-spike/*.onnx
tools/maia3-spike/*.mlpackage/

# Spike Scanner : le détecteur converti (10 Mo) et les images déjà mises au
# format d'entrée sont reconstruits par tools/yolo-spike/convert_yolo_onnx.py
# à partir des poids d'entraînement (runs/, déjà ignoré) et du modèle Core ML
# embarqué. Seul android_yolo_fixture.json est versionné : il garde la trace
# lisible des détections attendues.
tools/yolo-spike/*.onnx
tools/yolo-spike/*_640.png

# Trousseau de signature Android : jamais dans le dépôt.
android/keystore.properties
*.jks
*.keystore
